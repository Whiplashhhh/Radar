{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "check:feeds": "tsx scripts/check-feeds.ts",
    "demo:seed": "tsx scripts/demo-seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "undici": "^8.12.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.70.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
