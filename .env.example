# Port local (le conteneur n'écoute que sur 127.0.0.1)
PORT=8787
# Contact VAPID (mailto: ou https:)
VAPID_SUBJECT=mailto:moi@example.com
# Facultatif : clé NVD (50 req/30 s au lieu de 5) — https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Facultatif : token GitHub (lecture publique) pour relever la limite de l'API Advisories
GITHUB_TOKEN=
# Ollama (résumés + briefing du matin). Vide = désactivé.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
